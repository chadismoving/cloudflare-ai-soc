{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "example-soc-r2-retention-simulation-worker",
  "main": "src/r2-retention-worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 1000
  },
  "vars": {
    "APP_ENV": "cloud-simulation",
    "DATA_ENVIRONMENT": "simulation",
    "RETENTION_PROFILE": "simulation-r2-retention-workbench-v1",
    "RETENTION_MODE": "apply",
    "RETENTION_DATABASE_ID": "00000000-0000-4000-8000-000000000012",
    "RETENTION_ACCOUNT_ID": "00000000000000000000000000000001",
    "RETENTION_BUCKET": "example-cloudflare-ai-soc-simulation"
  },
  "d1_databases": [
    {
      "binding": "SIMULATION_DB",
      "database_name": "example-soc-simulation",
      "database_id": "00000000-0000-4000-8000-000000000012",
      "migrations_dir": "../../.local/workbench-cloud-review/migrations/simulation",
      "remote": false
    }
  ],
  "triggers": {
    "crons": ["37 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "SIMULATION_STORE",
      "bucket_name": "example-cloudflare-ai-soc-simulation",
      "remote": false
    }
  ]
}
