{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "soc-local-retention",
  "main": "src/retention-worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "APP_ENV": "local",
    "DATA_ENVIRONMENT": "simulation",
    "RETENTION_PROFILE": "local-retention-v1"
  },
  "d1_databases": [
    {
      "binding": "SIMULATION_DB",
      "database_name": "soc-local-simulation",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../infrastructure/migrations",
      "remote": false
    }
  ]
}
