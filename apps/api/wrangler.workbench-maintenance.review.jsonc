{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "example-soc-workbench-maintenance-simulation",
  "main": "src/workbench/maintenance-worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 1000
  },
  "vars": {
    "APP_ENV": "cloud-simulation",
    "MAINTENANCE_PROFILE": "simulation-workbench-maintenance-v1",
    "MAINTENANCE_MODE": "apply",
    "MAINTENANCE_ACCOUNT_ID": "00000000000000000000000000000001",
    "MAINTENANCE_DATABASE_ID": "00000000-0000-4000-8000-000000000012",
    "MAINTENANCE_BUCKET": "example-cloudflare-ai-soc-simulation"
  },
  "d1_databases": [
    {
      "binding": "SIMULATION_DB",
      "database_name": "example-soc-simulation",
      "database_id": "00000000-0000-4000-8000-000000000012",
      "migrations_dir": "../../.local/workbench-cloud-review/migrations/simulation",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "SIMULATION_EVIDENCE",
      "bucket_name": "example-cloudflare-ai-soc-simulation",
      "remote": false
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
