{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "example-soc-analytics-live",
  "main": "src/live/collector-worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 1000
  },
  "vars": {
    "LIVE_PROFILE": "zone-analytics-readonly-v1"
  },
  "d1_databases": [
    {
      "binding": "LIVE_DB",
      "database_name": "example-soc-live",
      "database_id": "00000000-0000-4000-8000-000000000013",
      "migrations_dir": "../../infrastructure/live-migrations",
      "remote": false
    }
  ]
}
