{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-soc-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "AUTH_MODE": "fixture",
    "ACCESS_ISSUER": "http://127.0.0.1:8787/__local/access",
    "ACCESS_AUDIENCE": "soc-local-fixture",
    "SOC_FEATURES": "full-simulation-v1"
  },
  "assets": { "directory": "../console/dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "soc-local-control",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../infrastructure/migrations",
      "remote": false
    },
    {
      "binding": "SIMULATION_DB",
      "database_name": "soc-local-simulation",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../infrastructure/migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "SIMULATION_EVIDENCE",
      "bucket_name": "soc-local-simulation-evidence",
      "remote": false
    }
  ]
}
